@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using MediatR
@using Microsoft.Extensions.Options
@using WeatherMonitor.Application
@using WeatherMonitor.Application.Enums
@using WeatherMonitor.Application.Requests
@using WeatherMonitor.Domain.Data
@inject IMediator Mediator
@inject IOptions<WeatherApiOptions> WeatherApiOptions

<PageTitle>Home</PageTitle>

<div class="app-card" id="app">
    <!-- Состояние загрузки -->
    <div class="state-overlay @(State == WeatherMonitorState.Loading ? "active" : "hidden")" id="loadingState">
        <div class="spinner"></div>
        <div class="state-title">Загрузка погоды</div>
        <div class="state-sub" id="loadingSub">Обновление данных...</div>
    </div>

    <!-- Состояние ошибки -->
    <div class="state-overlay @(State == WeatherMonitorState.Error ? "active" : "hidden")" id="errorState">
        <i class="bi bi-exclamation-circle" style="font-size:52px; color:#ffb4a2; margin-bottom:12px;"></i>
        <div class="state-title">Не удалось загрузить</div>
        <div class="state-sub">@ErrorMessage</div>
        <button class="btn-retry" id="retryBtn" onclick="@LoadWeather">
            <i class="bi bi-arrow-repeat" style="font-size:20px;"></i> Повторить
        </button>
    </div>

    <!-- Основной контент -->
    <div class="weather-content @(State == WeatherMonitorState.Complete ? "active" : "hidden")" id="weatherContent">

        <!-- Шапка -->
        <div class="city-header">
            <div class="city-name">
                <i class="bi bi-geo-alt"></i>
                <span id="cityName">@(WeatherData?.Location.Name ?? "--")</span>
            </div>
            <div class="update-badge" id="updateTime">Обновлено: @(WeatherData?.Current.LastUpdated ?? "--")</div>
        </div>

        <!-- Текущая погода -->
        <div class="current-weather" id="currentWeather">
            <div class="current-temp-row">
                <div>
                    <div class="temp-big" id="currentTemp">@(WeatherData?.Current.Temperature ?? 0)<sup>°C</sup></div>
                    <div class="current-desc" id="currentDesc">
                        <span class="badge" id="conditionText">@(WeatherData?.Current.Condition.Text ?? "--")</span>
                        <span class="badge">
                            <i class="bi bi-thermometer-half"></i> ощущается <span id="feelsLike">@(WeatherData?.Current.FeelsLike ?? 0)</span>°C
                        </span>
                    </div>
                </div>
                <div class="weather-icon-big" id="currentIcon">
                    <img src="@(WeatherData?.Current.Condition.Icon ?? "")" />
                </div>
            </div>
            <div class="extra-row">
                <div class="extra-item"><i class="bi bi-droplet"></i> Влажность: <span id="humidity">@(WeatherData?.Current.Humidity ?? 0)</span>%</div>
                <div class="extra-item"><i class="bi bi-wind"></i> Ветер: <span id="windSpeed">@(WeatherData?.Current.Wind ?? 0)</span> м/с</div>
                <div class="extra-item"><i class="bi bi-eye"></i> <span id="visiblity">@(WeatherData?.Current.Visibility ?? 0)</span> км</div>
            </div>
        </div>

        <!-- Почасовой прогноз -->
        <div class="section-title">
            <i class="bi bi-clock"></i> Почасовой
        </div>
        <div class="hourly-scroll" id="hourlyContainer">
            @if (WeatherData is null || WeatherData.Forecast.Forecastday[0].Hour.Count() == 0)
            {
                <div class="text-center text-white-50 w-100" style="padding: 20px;">
                    Нет данных о почасовой погоде
                </div>
            }
            else
            {
                foreach (var hour in WeatherData.Forecast.Forecastday[0].Hour)
                {
                    <HourItem HourTime="@(hour.Time)" Icon="@(hour.Condition.Icon)" Temperature="@(hour.Temperature)" DayLabel="Сегодня" />
                }

                foreach (var hour in WeatherData.Forecast.Forecastday[1].Hour)
                {
                    <HourItem HourTime="@(hour.Time)" Icon="@(hour.Condition.Icon)" Temperature="@(hour.Temperature)" DayLabel="Завтра" />
                }
            }
        </div>

        <!-- Прогноз на 3 дня -->
        <div class="section-title" style="margin-top: 8px;">
            <i class="bi bi-calendar3"></i> Прогноз на 3 дня
        </div>
        <div class="day-list" id="dayContainer">
            @if (WeatherData is null || WeatherData.Forecast.Forecastday.Count() == 0)
            {
                <div class="text-center text-white-50" style="padding: 20px;">
                    Нет данных о прогнозе
                </div>
            }
            else
            {
                var index = 0;
                foreach (var day in WeatherData.Forecast.Forecastday)
                {
                    var dayName = index == 0 ? "Сегодня" : index == 1 ? "Завтра" : DateTime.Parse(day.Date).ToString("ddd").ToUpper();
                    var max = day.Day.MaxTemperature;
                    var min = day.Day.MinTemperature;
                    var icon = day.Day.Condition.Icon;
                    var description = day.Day.Condition.Text;

                    <div class="day-card">
                        <div class="day-name">@dayName</div>
                        <div class="day-icon">
                            <span><img src="@icon" /></span>
                            <span class="desc-text">@description</span>
                        </div>
                        <div class="day-temps">
                            <span class="max-temp">@(max)°</span>
                            <span class="min-temp">@(min)°</span>
                        </div>
                    </div>

                    index++;
                }
            }
        </div>
    </div>

</div>

@code {
    private CancellationTokenSource cts = new();
    private WeatherMonitorState State = WeatherMonitorState.Loading;
    private string ErrorMessage = string.Empty;
    private WeatherData? WeatherData;

    protected override Task OnInitializedAsync()
    {
        return base.OnInitializedAsync();
    }

    protected override Task OnParametersSetAsync()
    {
        return base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadWeather();
    }

    private async Task LoadWeather()
    {
        if (WeatherData is not null) return;

        State = WeatherMonitorState.Loading;

        var options = WeatherApiOptions.Value;
        double lat = options.Lat;
        double lon = options.Lon;

        var request = new GetWeatherRequest(lat, lon);
        var response = await Mediator.Send(request, cts.Token);

        if (string.IsNullOrEmpty(response.ErrorMessage))
        {
            WeatherData = response.Data;
            State = WeatherMonitorState.Complete;
        }
        else
        {
            ErrorMessage = response.ErrorMessage;
            State = WeatherMonitorState.Error;
        }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (cts is null) return;

        if (State == WeatherMonitorState.Loading)
        {
            await cts.CancelAsync();            
        }

        cts.Dispose();
    }
}